{
  "name": "dsh-llm-commandcode",
  "description": "Command Code Provider API LLM plugin for DeepSeek Harness",
  "version": "0.1.33",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOirBRight/dsh-llm-commandcode.git"
  },
  "bugs": {
    "url": "https://github.com/NOirBRight/dsh-llm-commandcode/issues"
  },
  "homepage": "https://github.com/NOirBRight/dsh-llm-commandcode#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "DSH_ALPHA4_PLUGIN_ROOT=\"$PWD\" node scripts/check-alpha4-pack.mjs",
    "fixtures:alpha4": "DSH_ALPHA4_PLUGIN_ROOT=\"$PWD\" node scripts/prepare-alpha4-fixtures.mjs",
    "lab:check": "node scripts/check-lab.mjs",
    "check": "pnpm run test && pnpm run typecheck && pnpm run build && pnpm run pack:check && pnpm run check:alpha4-adapter",
    "check:alpha4-adapter": "node scripts/check-alpha4-adapter.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-alpha.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-authorization": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-util-values": "0.1.7-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-authorization": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-alpha.2",
    "dsh-llm-providers-ui": "https://github.com/NOirBRight/dsh-llm-providers-ui/releases/download/v0.2.12/dsh-llm-providers-ui-0.2.12.tgz",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-util-values": "0.1.7-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
